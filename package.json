{
  "name": "changelog-schema",
  "version": "0.1.0",
  "private": true,
  "description": "The CHANGELOG schema (changelog/v1): an append-only record of job-level changes, its plain-text interchange table, and a dependency-free library that reads and writes it.",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./ids": "./src/ids.mjs",
    "./time": {
      "types": "./src/time.d.mts",
      "default": "./src/time.mjs"
    },
    "./config": {
      "types": "./src/config.d.mts",
      "default": "./src/config.mjs"
    },
    "./config-md": {
      "types": "./src/config-md.d.mts",
      "default": "./src/config-md.mjs"
    },
    "./entries": {
      "types": "./src/entries.d.mts",
      "default": "./src/entries.mjs"
    },
    "./exporter": {
      "types": "./src/exporter.d.mts",
      "default": "./src/exporter.mjs"
    },
    "./importer": "./src/importer.mjs",
    "./migrate": "./src/migrate.mjs"
  },
  "files": [
    "src/*.mjs",
    "src/*.d.mts",
    "!src/*.test.mjs",
    "SPEC.md"
  ],
  "scripts": {
    "test": "node --test \"src/*.test.mjs\"",
    "check:app": "node scripts/check-app-sync.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
